# copy this to .env and adjust as needed

DOCKER=podman
PULL=true

# right for podman - adjust for docker
DOCKER_SOCKET=/run/user/${UID}/podman/podman.sock
DOCKER_HOST=unix://${DOCKER_SOCKET}

# ipv4 external address (needed for port 8443 ?)
MY_IPV4_ADDR=192.168.10.139

# all domains also should be in /etc/hosts if domain is 'local' only
AIO_BASE_DOMAIN=my.local
OTHER_BASE_DOMAIN=your.local
# should be nextcloud.$AIO_BASE_DOMAIN
AIO_DOMAIN=nextcloud.my.local
# should be subdomains of AIO_BASE_DOMAIN
AIO_SUBDOMAIN1=docs.my.local
AIO_SUBDOMAIN2=home.my.local
AIO_SUBDOMAIN3=what.my.local
# should be subdomains of OTHER_BASE_DOMAIN
OTHER_SUBDOMAIN1=host.your.local
OTHER_SUBDOMAIN2=myself.your.local
OTHER_SUBDOMAIN3=server.your.local

NEXTCLOUD_MOUNT=$PWD/backup

# host.containers.internal host.docker.internal
# TODO: not in use now
HOST_CONTAINER_INTERNAL=169.254.1.2
HOST6_CONTAINER_INTERNAL=::ffff:a9fe:102

# should be true if domain is 'local' only
SKIP_DOMAIN_VALIDATION=true
